---
import { getLang, href, t } from '../lib/i18n';
import { inline, stepById } from '../data/steps';

interface Props {
	step: string;
}

const lang = getLang(Astro);
const step = stepById(Astro.props.step);
---

<div class="done-when not-content">
	<ul class="done-list">
		{
			step.checks.map((check) => (
				<li class:list={['done-list__item', { 'done-list__item--path': check.path }]}>
					<svg class="done-box" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" focusable="false">
						<path d="M5 6 C 11 4 18 5 23 5 C 24 11 23 17 23 23 C 17 24 10 24 5 23 C 4 17 5 11 5 6 Z" />
					</svg>
					<span>
						<Fragment set:html={inline(check.text[lang])} />
						{check.path && <span class="path-tag">{t(lang, check.path === 'a' ? 'path.a.short' : 'path.b.short')}</span>}
					</span>
				</li>
			))
		}
	</ul>
	<a class="done-when__more" href={href(lang, 'resources/checklist')}>{t(lang, 'done.print')} →</a>
</div>
