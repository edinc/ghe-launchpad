---
import Default from '@astrojs/starlight/components/Footer.astro';
import { formatDate, getLang, href, t } from '../../lib/i18n';

const lang = getLang(Astro);
const { entry } = Astro.locals.starlightRoute;
const checked = entry.data.lastVerified;
---

<Default />
<div class="zine-footer">
	<svg class="zine-footer__star" viewBox="0 0 40 40" width="26" height="26" aria-hidden="true" focusable="false">
		<path d="M20 4 L20 36 M6 12 L34 28 M6 28 L34 12" />
	</svg>
	<p class="zine-footer__disclaimer">{t(lang, 'footer.disclaimer')}</p>
	{
		checked && (
			<p class="zine-footer__checked">
				{t(lang, 'footer.checked')} <time datetime={checked.toISOString().slice(0, 10)}>{formatDate(lang, checked)}</time>
			</p>
		)
	}
	<p class="zine-footer__links">
		<a href={href(lang, 'resources/about')}>{t(lang, 'footer.about')}</a>
		<span aria-hidden="true">·</span>
		<a href="https://github.com/edinc/ghe-launchpad/issues">{t(lang, 'footer.issue')}</a>
	</p>
</div>

<svg class="sk-defs" width="0" height="0" aria-hidden="true" focusable="false">
	<filter id="sk-wobble" x="-4%" y="-8%" width="108%" height="116%">
		<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="noise" />
		<feDisplacementMap in="SourceGraphic" in2="noise" scale="3.4" xChannelSelector="R" yChannelSelector="G" />
	</filter>
</svg>

<script>
	import '../../scripts/site';
</script>
