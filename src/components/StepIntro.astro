---
import SystemMap from './diagrams/SystemMap.astro';
import RoleTag from './RoleTag.astro';
import { getLang, href, t } from '../lib/i18n';
import { stepById } from '../data/steps';

interface Props {
	step: string;
}

const lang = getLang(Astro);
const step = stepById(Astro.props.step);
const needs = step.needs.map(stepById);
const hasReady = Astro.slots.has('default');
---

<section class="step-intro not-content" aria-label={`${t(lang, 'step')} ${step.num}`}>
	<div class="step-intro__facts">
		<dl class="step-intro__grid">
			<div class="fact fact--who">
				<dt>{t(lang, 'intro.who')}</dt>
				<dd class="fact__roles">
					{step.roles.map((role, i) => <RoleTag role={role} lead={i === 0} />)}
				</dd>
			</div>
			<div class="fact">
				<dt>{t(lang, 'intro.time')}</dt>
				<dd class="fact__big">{step.time[lang]}</dd>
			</div>
			{
				step.wait && (
					<div class="fact fact--wait">
						<dt>{t(lang, 'intro.wait')}</dt>
						<dd>
							<svg class="hourglass" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
								<path d="M6 3 C 10 3 15 3 18 3 M6 21 C 10 21 15 21 18 21 M7 3 C 7 9 16 10 16 12 C 16 14 7 15 7 21 M17 3 C 17 9 8 10 8 12 C 8 14 17 15 17 21" />
							</svg>
							{step.wait[lang]}
						</dd>
					</div>
				)
			}
			<div class="fact fact--needs">
				<dt>{t(lang, 'intro.needs')}</dt>
				<dd>
					{needs.length === 0 && <span class="fact__none">{t(lang, 'intro.nothing')}</span>}
					{
						needs.map((need) => (
							<a class="step-chip" href={href(lang, `steps/${need.id}`)}>
								<span class="step-chip__num">{need.num}</span>
								{need.short[lang]}
							</a>
						))
					}
				</dd>
			</div>
		</dl>
		{
			hasReady && (
				<div class="step-intro__ready">
					<p class="step-intro__ready-title">{t(lang, 'intro.before')}</p>
					<slot />
				</div>
			)
		}
	</div>
	<div class="step-intro__map">
		<SystemMap variant="mini" focus={step.focus} />
		<p class="step-intro__map-caption">{t(lang, 'intro.mapCaption')}</p>
	</div>
</section>
