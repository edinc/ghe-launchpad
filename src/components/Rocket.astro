---
import { rocketArt, type RocketMood } from '../lib/rocket';

interface Props {
	mood?: RocketMood;
	size?: string;
	class?: string;
	/** Accessible label; omit for decorative use. */
	label?: string;
}

const { mood = 'launch', size = '3rem', class: className, label } = Astro.props;
---

<svg
	class:list={['rocket', `rocket--${mood}`, className]}
	viewBox="0 0 120 120"
	width={size}
	height={size}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
	set:html={rocketArt(mood)}
/>
