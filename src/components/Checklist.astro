---
import RoleTag from './RoleTag.astro';
import { getLang, href, t } from '../lib/i18n';
import { inline, steps } from '../data/steps';

const lang = getLang(Astro);
---

<div class="checklist not-content">
	<button type="button" class="sketch-button sketch-button--secondary checklist__print" data-print>
		{t(lang, 'checklist.print')}
	</button>
	<ol class="checklist__steps">
		{
			steps.map((s) => (
				<li class="checklist__step">
					<h2 class="checklist__title">
						<span class="checklist__num">{s.num}</span>
						<a href={href(lang, `steps/${s.id}`)}>{s.title[lang]}</a>
					</h2>
					<p class="checklist__meta">
						{s.roles.map((role, i) => <RoleTag role={role} lead={i === 0} short />)}
						<span class="checklist__time">{s.time[lang]}</span>
					</p>
					<ul class="done-list">
						{s.checks.map((check) => (
							<li class="done-list__item">
								<svg class="done-box" viewBox="0 0 28 28" width="24" height="24" aria-hidden="true" focusable="false">
									<path d="M5 6 C 11 4 18 5 23 5 C 24 11 23 17 23 23 C 17 24 10 24 5 23 C 4 17 5 11 5 6 Z" />
								</svg>
								<span>
									<Fragment set:html={inline(check.text[lang])} />
									{check.path && <span class="path-tag">{t(lang, check.path === 'a' ? 'path.a.short' : 'path.b.short')}</span>}
								</span>
							</li>
						))}
					</ul>
				</li>
			))
		}
	</ol>
</div>
