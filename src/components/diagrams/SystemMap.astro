---
import { createSketch, label, type Tone } from '../../lib/rough';
import { getLang } from '../../lib/i18n';
import type { Focus } from '../../data/steps';

interface Props {
	variant?: 'full' | 'mini';
	focus?: Focus[];
	class?: string;
}

const { variant = 'full', focus = [], class: className } = Astro.props;
const lang = getLang(Astro);
const de = lang === 'de';
const overview = focus.length === 0;
const dim: Tone = variant === 'mini' ? 'soft' : 'muted';
const dimText = variant === 'mini' ? 'sk-text--soft' : 'sk-text--muted';
const on = (part: Focus) => overview || focus.includes(part);

const text = {
	entra: 'Microsoft Entra ID',
	entraShort: 'Entra ID',
	entraSub: de ? 'Benutzer & Gruppen' : 'users & groups',
	ghe: 'GHE.com',
	gheSub: 'SUBDOMAIN.ghe.com',
	copilot: 'GitHub Copilot',
	copilotShort: 'Copilot',
	orgs: de ? 'Orgs + Repos · Variante A' : 'orgs + repos · Path A',
	azure: de ? 'Azure-Abonnement' : 'Azure subscription',
	azureShort: 'Azure',
	azureSub: de ? 'zahlt die Rechnung' : 'pays the bill',
	ide: 'IDE / CLI',
	ideShort: 'IDE',
	ideSub: de ? 'Ihre Entwickler' : 'your developers',
	sso: 'Single Sign-On',
	ssoShort: 'SSO',
	scim: de ? 'Benutzer + Gruppen' : 'users + groups',
	scimShort: 'SCIM',
	billing: de ? 'Nutzung → Rechnung' : 'usage → invoice',
	billingShort: de ? 'Abrechnung' : 'billing',
	signin: de ? 'Anmeldung · Copilot' : 'sign in · Copilot',
	signinShort: 'login',
};

const description = de
	? 'Skizze: Microsoft Entra ID meldet Benutzer per Single Sign-On bei Ihrer GHE.com-Enterprise an und synchronisiert Benutzer und Gruppen per SCIM. Ihr Azure-Abonnement bezahlt die Nutzung. Entwickler melden sich aus IDE oder CLI an und nutzen Copilot.'
	: 'Sketch: Microsoft Entra ID signs people in to your GHE.com enterprise (single sign-on) and syncs users and groups (SCIM). Your Azure subscription pays for usage. Developers sign in from their IDE or CLI and use Copilot.';

const node = (part: Focus, fill: Tone) =>
	on(part)
		? { stroke: 'ink' as Tone, strokeWidth: 2.4, fill: overview ? fill : ('yellow' as Tone) }
		: { stroke: dim, strokeWidth: 1.6 };
const edge = (part: Focus) =>
	on(part)
		? { stroke: (overview ? 'ink' : 'pink') as Tone, strokeWidth: overview ? 2.2 : 3.2, draw: true }
		: { stroke: dim, strokeWidth: 1.5 };
const tc = (part: Focus) => (on(part) ? '' : dimText);

const sk = createSketch(variant === 'full' ? 11 : 23);
let labels = '';
let viewBox = '';

if (variant === 'full') {
	viewBox = '0 0 760 440';
	sk.rect(20, 150, 180, 120, node('entra', 'teal'));
	sk.rect(290, 64, 200, 240, node('ghe', 'yellow'));
	sk.rect(310, 160, 160, 62, { ...node('copilot', 'paper'), fillStyle: 'solid' });
	sk.rect(310, 240, 160, 44, { stroke: 'muted', strokeWidth: 1.5, dashed: true });
	sk.rect(290, 352, 200, 72, node('azure', 'pink'));
	sk.rect(580, 150, 160, 120, node('ide', 'teal'));
	sk.arrow([[200, 184], [246, 172], [288, 170]], edge('sso'));
	sk.arrow([[200, 238], [246, 250], [288, 252]], edge('scim'));
	sk.arrow([[390, 304], [392, 328], [390, 350]], edge('billing'));
	sk.arrow([[580, 210], [536, 204], [492, 206]], edge('signin'), 'both');
	labels =
		label(110, 202, text.entra, { size: 21, cls: tc('entra') }) +
		label(110, 232, text.entraSub, { size: 17, cls: `sk-text--soft ${tc('entra')}` }) +
		label(390, 104, text.ghe, { size: 26, cls: `sk-text--title ${tc('ghe')}` }) +
		label(390, 132, text.gheSub, { size: 16, cls: `sk-text--soft ${tc('ghe')}` }) +
		label(390, 198, text.copilot, { size: 20, cls: tc('copilot') }) +
		label(390, 268, text.orgs, { size: 15, cls: 'sk-text--muted' }) +
		label(390, 384, text.azure, { size: 20, cls: tc('azure') }) +
		label(390, 408, text.azureSub, { size: 16, cls: `sk-text--soft ${tc('azure')}` }) +
		label(660, 202, text.ide, { size: 21, cls: tc('ide') }) +
		label(660, 232, text.ideSub, { size: 17, cls: `sk-text--soft ${tc('ide')}` }) +
		label(245, 156, text.sso, { size: 15, cls: tc('sso') }) +
		label(245, 284, text.scim, { size: 15, cls: tc('scim') }) +
		label(402, 334, text.billing, { size: 15, anchor: 'start', cls: tc('billing') }) +
		label(536, 190, text.signin, { size: 15, cls: tc('signin') });
} else {
	viewBox = '0 0 360 236';
	sk.rect(6, 70, 92, 66, node('entra', 'teal'));
	sk.rect(140, 30, 112, 128, node('ghe', 'yellow'));
	sk.rect(152, 84, 88, 54, { ...node('copilot', 'paper'), fillStyle: 'solid' });
	sk.rect(140, 186, 112, 44, node('azure', 'pink'));
	sk.rect(292, 70, 62, 66, node('ide', 'teal'));
	sk.arrow([[98, 88], [120, 84], [139, 84]], edge('sso'));
	sk.arrow([[98, 118], [120, 122], [139, 124]], edge('scim'));
	sk.arrow([[196, 158], [197, 172], [196, 185]], edge('billing'));
	sk.arrow([[291, 104], [272, 102], [253, 104]], edge('signin'), 'both');
	labels =
		label(52, 109, text.entraShort, { size: 17, cls: tc('entra') }) +
		label(196, 60, text.ghe, { size: 19, cls: `sk-text--title ${tc('ghe')}` }) +
		label(196, 116, text.copilotShort, { size: 16, cls: tc('copilot') }) +
		label(196, 214, text.azureShort, { size: 17, cls: tc('azure') }) +
		label(323, 109, text.ideShort, { size: 17, cls: tc('ide') }) +
		label(119, 74, text.ssoShort, { size: 13, cls: tc('sso') }) +
		label(119, 146, text.scimShort, { size: 13, cls: tc('scim') }) +
		label(205, 177, text.billingShort, { size: 13, anchor: 'start', cls: tc('billing') }) +
		label(272, 92, text.signinShort, { size: 13, cls: tc('signin') });
}

const id = `sysmap-${variant}-${focus.join('-') || 'all'}`;
---

<figure class:list={['sk-figure', 'system-map', `system-map--${variant}`, className]}>
	<svg viewBox={viewBox} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
		<title id={`${id}-title`}>{de ? 'Ihr Setup als Skizze' : 'Your setup, sketched'}</title>
		<desc id={`${id}-desc`}>{description}</desc>
		<g set:html={sk.toString() + labels} />
	</svg>
</figure>
