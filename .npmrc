# Keep registry URLs out of package-lock.json: every install uses the registry configured on that
# machine (npmjs.org by default, a company mirror where one is set up). A mirror's URLs in the
# lockfile break Dependabot. SHA-512 hashes still pin every package (tests/unit/lockfile.test.ts);
# `npm run lockfile:sha512` replaces the SHA-1 values that some mirrors record.
omit-lockfile-registry-resolved=true
